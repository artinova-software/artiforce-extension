{
  "name": "@artiforce-software/browser-extension",
  "version": "0.0.0",
  "private": true,
  "description": "Artiforce browser extension (Chrome, Edge, Firefox; Manifest V3).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.background.json && tsc --noEmit -p test/e2e/tsconfig.json",
    "build:chrome": "webpack --env browser=chrome --env target=production",
    "build:edge": "webpack --env browser=edge --env target=production",
    "build:firefox": "webpack --env browser=firefox --env target=production",
    "build:staging:chrome": "webpack --env browser=chrome --env target=staging",
    "build:watch:chrome": "webpack --watch --env browser=chrome --env target=development",
    "build:e2e": "webpack --env browser=chrome --env target=e2e",
    "dev:chrome": "node scripts/dev-chrome.mjs",
    "test:e2e": "pnpm run build:e2e && playwright test",
    "lint:firefox": "web-ext lint --source-dir build/firefox-production --self-hosted=false",
    "zip": "node scripts/zip-build.mjs",
    "dist": "node scripts/dist-all.mjs"
  },
  "dependencies": {
    "@artiforce-software/extension-bridge": "workspace:*",
    "@artiforce-software/extension-suppliers": "workspace:*",
    "@phosphor-icons/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@swc/core": "1.16.18",
    "@tailwindcss/postcss": "catalog:",
    "@types/chrome": "0.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "fflate": "0.8.3",
    "html-webpack-plugin": "5.6.8",
    "mini-css-extract-plugin": "2.10.2",
    "postcss": "8.5.31",
    "postcss-loader": "8.2.1",
    "swc-loader": "0.2.7",
    "tailwindcss": "catalog:",
    "terser-webpack-plugin": "5.6.1",
    "typescript": "catalog:",
    "web-ext": "10.8.0",
    "webpack": "5.112.0",
    "webpack-cli": "7.2.3"
  }
}
